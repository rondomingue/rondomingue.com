<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050507">
<style>
  html { background: #050507; color-scheme: dark; }
  body { background: #050507; }
</style>
  <script>
    document.documentElement.classList.add('motion-ready');
    document.documentElement.dataset.theme = 'dark';
    try {
      if (localStorage.getItem('rd-theme') === 'light') {
        document.documentElement.dataset.theme = 'light';
      }
    } catch (error) {}
  </script>
  <title>{% if title %}{{ title }} — {% endif %}{{ site.siteName }}</title>
  <meta name="description" content="{{ description or site.description }}">
  {% if noIndex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" type="image/png" href="{{ '/images/favicon.png' | url }}">
  <link rel="stylesheet" href="{{ '/css/global.css' | url }}?v=21">
  <link rel="stylesheet" href="https://use.typekit.net/xhf1nbc.css">
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700&family=Barlow:wght@300;400;500&display=swap" rel="stylesheet">
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9CMETG9RBQ"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9CMETG9RBQ');
  </script>
</head>
<body class="{{ bodyClass }}">

  {% include "header.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}


  <script src="{{ '/js/page-reveal.js' | url }}?v=2" defer></script>
  <script src="{{ '/js/image-loader.js' | url }}?v=1" defer></script>
  <script src="{{ '/js/theme-toggle.js' | url }}?v=5" defer></script>

</body>
</html>
