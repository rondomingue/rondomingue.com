        <div class="analytics-panel-tabs">
          <button class="active" type="button" data-plum-tab="searches" data-plum-view="common">Most Common</button>
          <button type="button" data-plum-tab="searches" data-plum-view="recent">Recent</button>
        </div>
      </header>
      <table class="analytics-table" data-plum-table="searches">
        <thead><tr><th>Query</th><th>Hits</th></tr></thead>
        <tbody>
          <tr><td>cinematic ui design</td><td>37</td></tr>
          <tr><td>new orleans art director</td><td>29</td></tr>
          <tr><td>fui hud artist</td><td>21</td></tr>
