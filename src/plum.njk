---
layout: base.njk
title: Plum Analytics
description: A fuchsia-accented analytics console for rondomingue.com.
bodyClass: page-analytics
eleventyExcludeFromCollections: true
noIndex: true
---

<section class="analytics-shell" aria-labelledby="analytics-title">
  <div class="analytics-topbar">
    <div class="analytics-brand">
      <img class="analytics-logo" src="{{ '/images/misc/plum-logo.png' | url }}" alt="Plum">
      <div>
        <p class="analytics-kicker">rondomingue.com signal</p>
        <h1 id="analytics-title">Plum</h1>
      </div>
    </div>
    <p class="analytics-generated" data-plum-generated>Snapshot</p>
  </div>

  <div class="analytics-summary" aria-label="Current traffic summary" data-plum-summary>
    <article>
      <span>Today</span>
      <strong>1,284</strong>
      <em>+18%</em>
    </article>
    <article>
      <span>Unique</span>
      <strong>742</strong>
      <em>+9%</em>
    </article>
    <article>
      <span>Referrals</span>
      <strong>391</strong>
      <em>31%</em>
    </article>
    <article>
      <span>Live</span>
      <strong>27</strong>
      <em>now</em>
    </article>
  </div>

  <div class="analytics-grid">
    <section class="analytics-panel analytics-panel--wide" id="visits">
      <header>
        <h2>Fresh View</h2>
        <div class="analytics-panel-tabs" aria-label="Visit ranges">
          <button type="button" data-plum-tab="visits" data-plum-view="day">Past Day</button>
          <button class="active" type="button" data-plum-tab="visits" data-plum-view="week">Past Week</button>
          <button type="button" data-plum-tab="visits" data-plum-view="month">Past Month</button>
          <button type="button" data-plum-tab="visits" data-plum-view="year">Past Year</button>
        </div>
      </header>
      <div class="analytics-chart" role="img" aria-label="Weekly visits line chart with peaks on Friday and Monday">
        <div class="analytics-y-axis" data-plum-y-axis>
          <span>9k</span><span>6k</span><span>3k</span><span>0</span>
        </div>
        <svg viewBox="0 0 760 260" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="plum-area" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="rgba(200,40,154,0.82)" />
              <stop offset="1" stop-color="rgba(200,40,154,0.18)" />
            </linearGradient>
          </defs>
          <path class="analytics-area" d="M0 86 L118 48 L236 188 L354 198 L472 24 L590 142 L708 236 L760 244 L760 260 L0 260 Z" />
          <path class="analytics-line analytics-line--total" d="M0 86 L118 48 L236 188 L354 198 L472 24 L590 142 L708 236 L760 244" />
          <path class="analytics-line analytics-line--unique" d="M0 132 L118 96 L236 204 L354 214 L472 104 L590 178 L708 242 L760 248" />
          <g class="analytics-points">
            <circle cx="0" cy="86" r="5" /><circle cx="118" cy="48" r="5" /><circle cx="236" cy="188" r="5" /><circle cx="354" cy="198" r="5" /><circle cx="472" cy="24" r="5" /><circle cx="590" cy="142" r="5" /><circle cx="708" cy="236" r="5" />
          </g>
        </svg>
        <div class="analytics-x-axis">
          <span>Th</span><span>F</span><span>Sa</span><span>Su</span><span>M</span><span>Tu</span><span>W</span>
        </div>
        <div class="analytics-chart-stats" data-plum-visit-stats>
          <span>Past Week</span><strong>33,255</strong><em>19,510 unique</em>
        </div>
      </div>
    </section>

    <section class="analytics-panel" id="referrers">
      <header>
        <h2>Referrers</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button" data-plum-tab="referrers" data-plum-view="newest">Newest Unique</button>
          <button type="button" data-plum-tab="referrers" data-plum-view="repeat">Repeat</button>
        </div>
      </header>
      <table class="analytics-table" data-plum-table="referrers">
        <thead><tr><th>Source</th><th>Hits</th></tr></thead>
        <tbody>
          <tr><td>instagram.com</td><td>184</td></tr>
          <tr><td>behance.net</td><td>121</td></tr>
          <tr><td>google.com</td><td>97</td></tr>
          <tr><td>linkedin.com</td><td>84</td></tr>
          <tr><td>vimeo.com</td><td>62</td></tr>
          <tr><td>direct / bookmark</td><td>58</td></tr>
        </tbody>
      </table>
    </section>

    <section class="analytics-panel" id="pages">
      <header>
        <h2>Pages</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button" data-plum-tab="pages" data-plum-view="popular">Most Popular</button>
          <button type="button" data-plum-tab="pages" data-plum-view="recent">Most Recent</button>
        </div>
      </header>
      <table class="analytics-table" data-plum-table="pages">
        <thead><tr><th>Page</th><th>Views</th></tr></thead>
        <tbody>
          <tr><td>/work/the-colony/</td><td>411</td></tr>
          <tr><td>/work/signal-lattice/</td><td>306</td></tr>
          <tr><td>/photography/</td><td>248</td></tr>
