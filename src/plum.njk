          <tr><td>/about/</td><td>173</td></tr>
          <tr><td>/illustration/</td><td>149</td></tr>
        </tbody>
      </table>
    </section>

    <section class="analytics-panel" id="crushes">
      <header>
        <h2>Crushes</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button">Today</button>
        </div>
      </header>
      <table class="analytics-table" data-plum-table="crushes">
        <thead><tr><th>Page</th><th>Views</th></tr></thead>
        <tbody>
          <tr><td>/work/signal-lattice/</td><td>88</td></tr>
          <tr><td>/photography/</td><td>61</td></tr>
          <tr><td>/about/</td><td>39</td></tr>
          <tr><td>/work/the-colony/</td><td>34</td></tr>
        </tbody>
      </table>
    </section>

    <section class="analytics-panel analytics-panel--tall">
      <header>
        <h2>Live Visitors</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button" data-plum-tab="live" data-plum-view="newest">Newest</button>
          <button type="button" data-plum-tab="live" data-plum-view="city">City</button>
          <button type="button" data-plum-tab="live" data-plum-view="country">Country</button>
        </div>
      </header>
      <ol class="analytics-feed" data-plum-live>
        <li><strong>New Orleans</strong><span>/work/black-noise/</span><em>2 mins ago</em></li>
        <li><strong>Brooklyn</strong><span>/work/grid-state/</span><em>5 mins ago</em></li>
        <li><strong>Austin</strong><span>/photography/</span><em>8 mins ago</em></li>
        <li><strong>Los Angeles</strong><span>/work/data-haven/</span><em>12 mins ago</em></li>
        <li><strong>Chicago</strong><span>/about/</span><em>18 mins ago</em></li>
        <li><strong>Seattle</strong><span>/work/hud-schema-signal/</span><em>24 mins ago</em></li>
        <li><strong>Atlanta</strong><span>/work/missionlaunch/</span><em>31 mins ago</em></li>
      </ol>
    </section>

    <section class="analytics-panel" id="seeds">
      <header>
        <h2>Seeds</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button">Entry Pages</button>
        </div>
      </header>
      <table class="analytics-table" data-plum-table="entryPages">
        <thead><tr><th>Landing Page</th><th>Sessions</th></tr></thead>
        <tbody>
          <tr><td>/</td><td>188</td></tr>
          <tr><td>/work/</td><td>96</td></tr>
