          <tr><td>unreal interface concepts</td><td>12</td></tr>
        </tbody>
      </table>
    </section>

    <section class="analytics-panel" id="browsers">
      <header>
        <h2>Browsers</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button">Sessions</button>
        </div>
      </header>
      <table class="analytics-table" data-plum-table="browsers">
        <thead><tr><th>Browser</th><th>%</th></tr></thead>
        <tbody>
          <tr><td>Safari</td><td>46</td></tr>
          <tr><td>Chrome</td><td>38</td></tr>
          <tr><td>Firefox</td><td>8</td></tr>
          <tr><td>Edge</td><td>5</td></tr>
        </tbody>
      </table>
    </section>

    <section class="analytics-panel analytics-panel--wide" id="atlas">
      <header>
        <h2>Atlas</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button">Countries</button>
        </div>
      </header>
      <div class="analytics-map" data-plum-map>
        <div class="analytics-map-canvas" data-plum-map-canvas role="img" aria-label="Visitor countries map"></div>
        <div class="analytics-map-empty" data-plum-map-empty hidden>Country data will appear after the next snapshot.</div>
      </div>
    </section>

    <section class="analytics-panel" id="countries">
      <header>
        <h2>Countries</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button">30 Days</button>
        </div>
      </header>
      <div class="analytics-country-list" data-plum-countries>
        <div><strong>🇺🇸 United States</strong><span class="analytics-meter" aria-label="68%"><span style="width:68%"></span></span><em>68%</em></div>
        <div><strong>🇨🇦 Canada</strong><span class="analytics-meter" aria-label="12%"><span style="width:12%"></span></span><em>12%</em></div>
        <div><strong>🇬🇧 United Kingdom</strong><span class="analytics-meter" aria-label="9%"><span style="width:9%"></span></span><em>9%</em></div>
      </div>
    </section>

    <section class="analytics-panel" id="providers">
      <header>
        <h2>Providers</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button">Channels</button>
        </div>
      </header>
      <table class="analytics-table" data-plum-table="providers">
        <thead><tr><th>Channel</th><th>Sessions</th></tr></thead>
        <tbody>
          <tr><td>Direct</td><td>220</td></tr>
          <tr><td>Organic Search</td><td>144</td></tr>
          <tr><td>Referral</td><td>88</td></tr>
          <tr><td>Organic Social</td><td>42</td></tr>
        </tbody>
      </table>
    </section>

    <section class="analytics-panel" id="devices">
      <header>
        <h2>Real Estate</h2>
        <div class="analytics-panel-tabs">
          <button class="active" type="button" data-plum-tab="devices" data-plum-view="platform">Platform</button>
          <button type="button" data-plum-tab="devices" data-plum-view="screen">Screen</button>
        </div>
      </header>
      <div class="analytics-bars" data-plum-devices>
        <div><span>390x844</span><span class="analytics-meter" aria-label="34%"><span style="width:34%"></span></span><em>34%</em></div>
        <div><span>1440x900</span><span class="analytics-meter" aria-label="22%"><span style="width:22%"></span></span><em>22%</em></div>
        <div><span>1920x1080</span><span class="analytics-meter" aria-label="18%"><span style="width:18%"></span></span><em>18%</em></div>
        <div><span>unknown</span><span class="analytics-meter" aria-label="9%"><span style="width:9%"></span></span><em>9%</em></div>
      </div>
