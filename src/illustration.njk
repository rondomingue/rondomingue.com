---
layout: base.njk
title: Illustration
description: Selected illustration, poster art, portraiture, and visual development by New Orleans artist Ron Domingue.
navActive: illustration
bodyClass: page-illustration
permalink: illustration/index.html
---

<section class="illustration-index">
  <header class="work-index-header">
    <h1 class="section-label">Illustration</h1>
    <span class="section-count">{{ illustrations | length }} works</span>
  </header>

  <p class="section-description">Selected illustration, poster art, portraiture, and visual development by New Orleans artist Ron Domingue.</p>

  <div class="illustration-filters" aria-label="Filter illustrations by orientation">
    <button class="illustration-filter active" type="button" data-orientation="all">All</button>
    <button class="illustration-filter" type="button" data-orientation="portrait">Portrait</button>
    <button class="illustration-filter" type="button" data-orientation="landscape">Landscape</button>
    <button class="illustration-filter" type="button" data-orientation="square">Square</button>
  </div>

  <div class="illustration-mosaic">
    {% for artwork in illustrations %}
    <figure class="illustration-tile" data-orientation="{{ artwork.orientation }}">
      <button class="illustration-open" type="button" aria-label="Open {{ artwork.alt }}" data-index="{{ loop.index0 }}">
        <img
          src="{{ ('/' + artwork.src) | url }}"
          alt="{{ artwork.alt }}"
          width="{{ artwork.width }}"
          height="{{ artwork.height }}"
          loading="lazy">
        <span class="illustration-tile-meta">
          <span>{{ artwork.alt }}</span>
          <span>{{ artwork.orientation }}</span>
        </span>
      </button>
    </figure>
    {% endfor %}
  </div>
</section>

<div class="illustration-lightbox" aria-hidden="true">
  <button class="illustration-lightbox-close" type="button" aria-label="Close artwork">Close</button>
  <button class="illustration-lightbox-nav illustration-lightbox-prev" type="button" aria-label="Previous artwork">Prev</button>
  <figure>
    <img class="illustration-lightbox-image" src="" alt="">
    <figcaption class="illustration-lightbox-caption"></figcaption>
  </figure>
  <button class="illustration-lightbox-nav illustration-lightbox-next" type="button" aria-label="Next artwork">Next</button>
</div>

<script src="{{ '/js/mosaic-motion.js' | url }}"></script>
<script>
  (() => {
    const filters = document.querySelector('.illustration-filters');
    const tiles = [...document.querySelectorAll('.illustration-tile')];
    const lightbox = document.querySelector('.illustration-lightbox');
    const lightboxImage = lightbox.querySelector('.illustration-lightbox-image');
    const lightboxCaption = lightbox.querySelector('.illustration-lightbox-caption');
    const closeButton = lightbox.querySelector('.illustration-lightbox-close');
    let visibleTiles = tiles;
    let activeIndex = 0;

    filters.addEventListener('click', event => {
      const button = event.target.closest('.illustration-filter');
      if (!button) return;
      filters.querySelectorAll('.illustration-filter').forEach(item => item.classList.remove('active'));
      button.classList.add('active');
      const orientation = button.dataset.orientation;
      window.animateMosaicFilter(tiles, orientation, filters).then(() => {
        visibleTiles = tiles.filter(tile => !tile.hidden);
      });
    });

    const render = index => {
      activeIndex = (index + visibleTiles.length) % visibleTiles.length;
      const image = visibleTiles[activeIndex].querySelector('img');
      lightboxImage.src = image.currentSrc || image.src;
      lightboxImage.alt = image.alt;
      lightboxCaption.textContent = `${image.alt} — ${activeIndex + 1} / ${visibleTiles.length}`;
    };

    const open = tile => {
      visibleTiles = tiles.filter(item => !item.hidden);
      render(visibleTiles.indexOf(tile));
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('lightbox-open');
      closeButton.focus();
    };

    const close = () => {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('lightbox-open');
    };

    tiles.forEach(tile => tile.querySelector('.illustration-open').addEventListener('click', () => open(tile)));
    closeButton.addEventListener('click', close);
    lightbox.querySelector('.illustration-lightbox-prev').addEventListener('click', () => render(activeIndex - 1));
    lightbox.querySelector('.illustration-lightbox-next').addEventListener('click', () => render(activeIndex + 1));
    lightbox.addEventListener('click', event => { if (event.target === lightbox) close(); });
    document.addEventListener('keydown', event => {
      if (!lightbox.classList.contains('active')) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowLeft') render(activeIndex - 1);
      if (event.key === 'ArrowRight') render(activeIndex + 1);
    });
  })();
</script>
