---
layout: base.njk
title: Work
description: Selected art direction, cinematic environments, motion design, and visual development by New Orleans artist Ron Domingue.
navActive: work
bodyClass: page-work
---

<section class="work-index">
  <div class="work-index-header">
    <h1 class="section-label">Work</h1>
    <span class="section-count"><span class="section-count-number">{{ projects | length }}</span> projects</span>
  </div>

  <p class="section-description">Selected art direction, cinematic environments, motion design, and visual development by New Orleans artist Ron Domingue.</p>

  <div class="work-filters" aria-label="Filter work by tag">
    <button class="work-filter active" type="button" data-filter="all">All</button>
  </div>

  <div class="work-grid work-grid--full">
    {% for project in projects %}
    <a class="work-card" href="{{ ('/work/' + project.slug + '/') | url }}" data-tags="{{ project.tags | join('|') }}">
      <div class="work-card-img" style="background-image: url('{{ ('/' + project.thumb) | url }}')"></div>
      <div class="work-card-overlay"></div>
      <div class="work-card-info">
        <div class="work-card-tags">
          {% for tag in project.tags %}<span class="work-tag work-tag-filter" role="button" tabindex="0" data-filter="{{ tag }}" aria-label="Filter work by {{ tag }}">{{ tag }}</span>{% endfor %}
          <span class="work-tag">{{ project.year }}</span>
        </div>
        <div class="work-card-title">{{ project.title }}</div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>

<script>
  (() => {
    const filterHost = document.querySelector('.work-filters');
    const workGrid = document.querySelector('.work-grid');
    const workCards = [...workGrid.querySelectorAll('.work-card')];

    for (let index = workCards.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [workCards[index], workCards[randomIndex]] = [workCards[randomIndex], workCards[index]];
    }
    workCards.forEach(card => workGrid.appendChild(card));

    const tags = [...new Set(workCards.flatMap(card => card.dataset.tags.split('|')))].sort();

    tags.forEach(tag => {
      const button = document.createElement('button');
      button.className = 'work-filter';
      button.type = 'button';
      button.dataset.filter = tag;
      button.textContent = tag;
      filterHost.appendChild(button);
    });

    const applyFilter = filter => {
      filterHost.querySelectorAll('.work-filter').forEach(item => item.classList.remove('active'));
      const activeButton = [...filterHost.querySelectorAll('.work-filter')]
        .find(item => item.dataset.filter === filter);
      if (activeButton) activeButton.classList.add('active');
      workCards.forEach(card => {
        const visible = filter === 'all' || card.dataset.tags.split('|').includes(filter);
        card.hidden = !visible;
      });
    };

    filterHost.addEventListener('click', event => {
      const button = event.target.closest('.work-filter');
      if (!button) return;
      applyFilter(button.dataset.filter);
    });

    const filterFromCardTag = event => {
      const tag = event.target.closest('.work-tag-filter');
      if (!tag) return;
      event.preventDefault();
      event.stopPropagation();
      applyFilter(tag.dataset.filter);
    };

    workGrid.addEventListener('click', filterFromCardTag);
    workGrid.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      filterFromCardTag(event);
    });
  })();
</script>
