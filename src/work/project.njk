---
layout: base.njk
pagination:
  data: publishedProjects
  size: 1
  alias: project
permalink: "work/{{ project.slug }}/index.html"
eleventyComputed:
  title: "{{ project.title | safe }}"
navActive: work
bodyClass: page-work page-project
---

<article class="project-detail">
  <header class="project-intro">
    <div class="project-title-block">
      <a class="project-back" href="{{ '/work/' | url }}">Back to Work</a>
      <div class="project-kicker">
        <span>{{ project.year }}</span>
        {% for tag in project.tags %}<span>{{ tag }}</span>{% endfor %}
      </div>
      <h1>{{ project.title }}</h1>
      {% if project.subtitle %}<p class="project-subtitle">{{ project.subtitle }}</p>{% endif %}
      {% if project.liveLinks or project.liveUrl %}
      <div class="project-live-links">
        {% if project.liveLinks %}
          {% for link in project.liveLinks %}
          <a class="project-live-button" href="{{ link.url }}" target="_blank" rel="noopener">
            {{ link.label }} ↗
          </a>
          {% endfor %}
        {% else %}
          <a class="project-live-button" href="{{ project.liveUrl }}" target="_blank" rel="noopener">
            View live site ↗
          </a>
        {% endif %}
      </div>
      {% endif %}
    </div>

    <div class="project-copy">
      <p class="project-summary">{{ project.summary | inlineLinks | safe }}</p>
      {% for paragraph in project.description %}
      <p>{{ paragraph | inlineLinks | safe }}</p>
      {% endfor %}
      <div class="project-tags">
        {% for tag in project.processTags %}
        <span>{{ tag }}</span>
        {% endfor %}
      </div>
    </div>
  </header>

  {% set videoProvider = project.video.provider if project.video and project.video.id else ('youtube' if project.vimeo else '') %}
  {% set videoId = project.video.id if project.video and project.video.id else project.vimeo %}
  {% set videoPoster = project.thumb or (project.images[0].src if project.images and project.images[0].src else project.images[0]) %}
  {% set videoAspectRatio = project.video.aspectRatio if project.video and project.video.aspectRatio else (project.videoAspectRatio or '16 / 9') %}
  {% if videoId %}
  <div class="project-player" style="--project-video-aspect-ratio: {{ videoAspectRatio }};">
    <div class="project-video" data-project-video>
      <button
        class="project-video-poster"
        type="button"
        data-project-video-embed="{% if videoProvider == 'vimeo' %}https://player.vimeo.com/video/{{ videoId }}?autoplay=1&title=0&byline=0&portrait=0{% else %}https://www.youtube-nocookie.com/embed/{{ videoId }}?rel=0&modestbranding=1&autoplay=1&mute=1&playsinline=1&enablejsapi=1{% endif %}"
        aria-label="Play {{ project.title }} video">
        {% if videoPoster %}
        <img src="{{ ('/' + videoPoster) | url }}" alt="" loading="lazy">
        {% endif %}
        <span class="project-video-overlay" aria-hidden="true">
          <span class="project-video-play">Play video</span>
        </span>
      </button>
      <a class="project-video-link" href="{% if videoProvider == 'vimeo' %}https://vimeo.com/{{ videoId }}{% else %}https://www.youtube.com/watch?v={{ videoId }}{% endif %}" target="_blank" rel="noopener">
        Open on {% if videoProvider == 'vimeo' %}Vimeo{% else %}YouTube{% endif %} ↗
      </a>
    </div>
  </div>
  {% endif %}


  {% if project.images and project.images.length %}
  <section class="project-gallery" aria-label="{{ project.title }} image gallery">
    {% for image in project.images %}
    {% set imageSrc = image.src or image %}
    <figure class="project-gallery-item image-load-frame image-loading{% if loop.first %} project-gallery-item--wide{% endif %}">
      <button class="project-gallery-button" type="button" data-gallery-index="{{ loop.index0 }}" aria-label="Open image {{ loop.index }} of {{ project.images.length }}">
        <img src="{{ ('/' + imageSrc) | url }}" alt="{{ image.alt or project.title }}" loading="lazy">
      </button>
      {% if image.caption %}
      <figcaption>{{ image.caption }}</figcaption>
      {% endif %}
    </figure>
    {% endfor %}
  </section>
  {% endif %}

  <section class="project-meta">
    <div>
      <span class="project-meta-label">Format</span>
      <p>{{ project.format or "Cinematic environment study" }}</p>
    </div>
    <div>
      <span class="project-meta-label">Tools</span>
      <p>{% for tag in project.tags %}{% if not loop.first %}, {% endif %}{{ tag }}{% endfor %}</p>
    </div>
    <div>
      <span class="project-meta-label">Year</span>
      <p>{{ project.year }}</p>
    </div>
  </section>

{% set previousProject = publishedProjects | previousProject(project.slug) %}
{% set nextProject = publishedProjects | nextProject(project.slug) %}
<nav class="project-adjacent" aria-label="Adjacent projects">
  <a class="project-adjacent-link project-adjacent-link--previous" href="{{ ('/work/' + previousProject.slug + '/') | url }}">
    <span class="project-adjacent-arrow" aria-hidden="true">←</span>
    <span>
      <span class="project-adjacent-label">Previous</span>
      <strong>{{ previousProject.title }}</strong>
    </span>
  </a>
  <a class="project-adjacent-link project-adjacent-link--next" href="{{ ('/work/' + nextProject.slug + '/') | url }}">
    <span>
      <span class="project-adjacent-label">Next</span>
      <strong>{{ nextProject.title }}</strong>
    </span>
    <span class="project-adjacent-arrow" aria-hidden="true">→</span>
  </a>
</nav>

<div class="project-back-footer">
  <a class="project-back project-back--bottom" href="{{ '/work/' | url }}">Back to Work</a>
</div>
</article>

{% if project.images and project.images.length %}
<div class="project-lightbox" aria-hidden="true">
  <button class="project-lightbox-close" type="button" aria-label="Close image">Close</button>
  <button class="project-lightbox-nav project-lightbox-prev" type="button" aria-label="Previous image">Prev</button>
  <figure class="project-lightbox-frame">
    <img class="project-lightbox-image" src="" alt="">
    <figcaption class="project-lightbox-caption"></figcaption>
  </figure>
  <button class="project-lightbox-nav project-lightbox-next" type="button" aria-label="Next image">Next</button>
</div>

<script>
  (() => {
    const galleryItems = [...document.querySelectorAll('.project-gallery-item')];
    const lightbox = document.querySelector('.project-lightbox');
    if (!galleryItems.length || !lightbox) return;

    const image = lightbox.querySelector('.project-lightbox-image');
    const caption = lightbox.querySelector('.project-lightbox-caption');
    const closeButton = lightbox.querySelector('.project-lightbox-close');
    const prevButton = lightbox.querySelector('.project-lightbox-prev');
    const nextButton = lightbox.querySelector('.project-lightbox-next');
    const openButtons = galleryItems.map(item => item.querySelector('.project-gallery-button'));
    let activeIndex = 0;

    const getItemData = index => {
      const item = galleryItems[index];
      const itemImage = item.querySelector('img');
      const itemCaption = item.querySelector('figcaption');
      return {
        src: itemImage.currentSrc || itemImage.src,
        alt: itemImage.alt,
        caption: itemCaption ? itemCaption.textContent : ''
      };
    };

    const render = index => {
      activeIndex = (index + galleryItems.length) % galleryItems.length;
      const item = getItemData(activeIndex);
      image.src = item.src;
      image.alt = item.alt;
      caption.textContent = item.caption || `${activeIndex + 1} / ${galleryItems.length}`;
    };

    const openLightbox = index => {
      render(index);
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('lightbox-open');
      closeButton.focus();
    };

    const closeLightbox = () => {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('lightbox-open');
      openButtons[activeIndex].focus();
    };

    openButtons.forEach((button, index) => {
      button.addEventListener('click', () => openLightbox(index));
    });

    closeButton.addEventListener('click', closeLightbox);
    prevButton.addEventListener('click', () => render(activeIndex - 1));
    nextButton.addEventListener('click', () => render(activeIndex + 1));
    lightbox.addEventListener('click', event => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', event => {
      if (!lightbox.classList.contains('active')) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowLeft') render(activeIndex - 1);
      if (event.key === 'ArrowRight') render(activeIndex + 1);
    });
  })();
</script>
{% endif %}

<script>
  (() => {
    document.querySelectorAll('[data-project-video]').forEach(player => {
      const button = player.querySelector('[data-project-video-embed]');
      if (!button) return;

      button.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = button.dataset.projectVideoEmbed;
        iframe.title = button.getAttribute('aria-label') || 'Project video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        player.replaceChildren(iframe);
      });
    });
  })();
</script>
